**/*.pyc
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/.env
tests
docs
scripts/.cache
data-local
deploy/compose.yaml
deploy/.env.example
deploy/quadlet
deploy/k8s
deploy/README.md
README.md
ARCHITECTURE.md
.DS_Store
node_modules
