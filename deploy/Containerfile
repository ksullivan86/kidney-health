# syntax=docker/dockerfile:1
# Kidney Health food log -- the published image (ghcr.io/ksullivan86/kidney-health).
# Spec: docs/dev/research/01-rootless-and-security.md §5.1 and §10.
#
# Build from the REPOSITORY ROOT. The root .dockerignore is an allowlist: only app/, data/foods.json,
# LICENSE, requirements.lock and handbook/ reach the build context (never deploy/secrets/):
#   podman build --format docker -f deploy/Containerfile -t kidney-health:local .
#   docker build -f deploy/Containerfile -t kidney-health:local .
# (`--format docker` keeps the HEALTHCHECK below; Podman's default OCI format drops it. Compose,
# Quadlet and Kubernetes declare the same probe themselves.)
#
# What this image guarantees (checked by the CI smoke test in .github/workflows/ci.yml):
#   * runtime has no shell, no pip and no package manager (Chainguard python:latest);
#   * application code and the venv are owned by root and not writable by the app user;
#   * the only writable path is /data (owner 10001, group 0, mode 0770), so the image also runs
#     read-only and under an arbitrary UID with GID 0 (OpenShift style);
#   * dependencies are installed from the hash-locked requirements.lock, wheels only;
#   * uvicorn runs with --no-proxy-headers: the app applies X-Forwarded-* itself, and only from
#     TRUSTED_PROXIES (app/security.py).
#
# Base images: literal `FROM image:tag@sha256:` lines so Dependabot (docker ecosystem, directory
# /deploy, group "base-images") bumps builder, handbook and runtime together. Chainguard's free tier
# publishes only :latest and :latest-dev, so the digest is what pins the Python version (3.14 when
# these digests were resolved on 2026-10-06). Re-resolve by hand with:
#   crane digest cgr.dev/chainguard/python:latest-dev ; crane digest cgr.dev/chainguard/python:latest
# The Debian fallback (deploy/Containerfile.debian) is built by CI on pull requests but not published.

# ---------------------------------------------------------------------------------------------------
# Stage 1: builder. A venv without pip; the builder's own pip installs into it (pip >= 22.3 --python).
# ---------------------------------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest-dev@sha256:a876b1000774bdd68322ac020cd813aaf42b52941ca812f4d2f0149059bd0e67 AS builder
# Root only in this throw-away stage (it creates /opt/venv); the runtime stage ends as 10001.
# hadolint ignore=DL3002
USER 0
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /build
COPY requirements.lock ./
# --require-hashes: every wheel must match a hash in the lock. --only-binary=:all:: no sdist build
# backend ever runs here. --no-deps: the lock is complete, nothing is resolved at build time.
RUN python -m venv --without-pip /opt/venv \
 && python -m pip --python /opt/venv/bin/python install --no-cache-dir \
      --no-deps --require-hashes --only-binary=:all: -r requirements.lock
COPY app/ /opt/app/app/
COPY data/foods.json /opt/app/data/foods.json
COPY LICENSE /opt/app/LICENSE
# Byte-compile once (the runtime rootfs is read-only), then normalise modes whatever the checkout's
# umask was: directories 0755, files 0644 (executables 0755), nothing group- or world-writable.
RUN /opt/venv/bin/python -m compileall -q -j 0 /opt/venv /opt/app/app \
 && chmod -R u=rwX,go=rX /opt/venv /opt/app \
 && mkdir -p /out/rootfs/data \
 && chmod 0770 /out/rootfs/data

# ---------------------------------------------------------------------------------------------------
# Stage 2: handbook. PLACEHOLDER -- filled in by M3 integration (ARCHITECTURE.md milestones;
# docs/dev/research/08-handbook-site.md §4.7). Until then it only provides an empty /out/learn, so
# /learn answers 404 (app/handbook.py serves it only when index.html exists).
# M3 replaces the WORKDIR line below with, in this order:
#   COPY handbook/requirements.lock /tmp/handbook.lock
#   RUN python -m venv /opt/hb && /opt/hb/bin/pip install --no-cache-dir --require-hashes \
#         --only-binary=:all: -r /tmp/handbook.lock
#   COPY handbook/ /src/handbook/
#   ENV NO_MKDOCS_2_WARNING=true HANDBOOK_SITE_URL=http://localhost/learn/ HANDBOOK_APP_LINK=/
#   RUN cd /src/handbook && /opt/hb/bin/mkdocs build --strict -d /out/learn \
#    && find /out/learn -name '*.map' -delete
# and adds " AND CC-BY-NC-SA-4.0" (the handbook text licence) to the licenses label below.
# Keep the FROM line identical to the builder's so Dependabot bumps all three together.
# ---------------------------------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest-dev@sha256:a876b1000774bdd68322ac020cd813aaf42b52941ca812f4d2f0149059bd0e67 AS handbook
# hadolint ignore=DL3002
USER 0
WORKDIR /out/learn

# ---------------------------------------------------------------------------------------------------
# Stage 3: runtime. Chainguard python:latest: no shell, no pip, no apk; glibc (manylinux wheels).
# ---------------------------------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest@sha256:3de78d5699d76c56f74a4a47abcd81f22f5a16757eee9fac45837fb2ae3f0e06

# OCI annotations. CI (docker/metadata-action) adds version, revision and created. The licence is
# the SPDX id of LICENSE: PolyForm Noncommercial 1.0.0 (personal and noncommercial use only).
LABEL org.opencontainers.image.title="kidney-health" \
      org.opencontainers.image.description="Self-hosted food log with renal-diet and type 1 diabetes nutrient warnings" \
      org.opencontainers.image.source="https://github.com/ksullivan86/kidney-health" \
      org.opencontainers.image.url="https://github.com/ksullivan86/kidney-health" \
      org.opencontainers.image.documentation="https://github.com/ksullivan86/kidney-health/blob/main/docs/deployment.md" \
      org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0" \
      org.opencontainers.image.base.name="cgr.dev/chainguard/python:latest"

# PYTHONPATH makes `python -m app.admin` work from any working directory (kubectl exec, podman exec).
# DATA_DIR is explicit: app/config.py only auto-detects Podman/Docker, not containerd.
ENV PATH=/opt/venv/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DATA_DIR=/data \
    HANDBOOK_DIR=/app/learn

COPY --from=builder  --chown=0:0     /opt/venv  /opt/venv
COPY --from=builder  --chown=0:0     /opt/app   /app
COPY --from=handbook --chown=0:0     /out/learn /app/learn
# /data must keep mode 0770 (group 0 writable, for runs as an arbitrary UID with GID 0). COPY of a
# directory copies its contents and creates the destination with default 0755, so copy the staging
# tree's *entry* instead: /out/rootfs/data lands as /data with its own mode.
COPY --from=builder  --chown=10001:0 /out/rootfs/ /

WORKDIR /app
# Keep UID 10001: every existing volume is owned by it. Never 65532 (the base image default).
USER 10001:10001
EXPOSE 8000
# All persistent state (kidney.db + WAL files, and the auto-generated secret.key fallback).
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["python", "-m", "app.healthcheck"]

# The base image's ENTRYPOINT is the bare interpreter; replace it.
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app"]
# --no-proxy-headers: X-Forwarded-* are applied once, by the app, only from TRUSTED_PROXIES (§5.5).
# --limit-concurrency 64: answer 503 beyond 64 concurrent connections (§10 S9).
CMD ["--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-server-header", \
     "--timeout-graceful-shutdown", "10", "--limit-concurrency", "64"]
