# kidney-health.container -- systemd Quadlet unit for ROOTLESS Podman (the recommended way to run
# the app on a single host). Spec: docs/dev/research/01-rootless-and-security.md §5.2 and §10.
# Works with Podman >= 4.9 (Ubuntu 24.04 LTS); the optional Notify=healthy needs 5.0, Memory= 5.5.
# Full guide: docs/deployment.md. Hardening background: docs/security.md.
#
# Install as the unprivileged user that will run the container (never root):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/quadlet/kidney-health.container deploy/quadlet/kidney-health.volume ~/.config/containers/systemd/
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))" | podman secret create kidney-secret-key -
#   systemctl --user daemon-reload                  # Quadlet generates kidney-health.service
#   systemctl --user start kidney-health.service
#   sudo loginctl enable-linger "$USER"             # keep it running after logout; start at boot
#   journalctl --user -u kidney-health | grep 'FIRST-RUN SETUP'     # the one-time setup code
#
# Check the result:
#   podman info --format '{{.Host.Security.Rootless}}'        # true
#   podman top kidney-health user huser                       # 10001  <a subordinate UID>, never your UID
#   podman inspect kidney-health --format '{{.HostConfig.ReadonlyRootfs}} {{.HostConfig.CapDrop}}'
# Typos make daemon-reload skip the unit silently; check with the generator:
#   /usr/libexec/podman/quadlet -user -dryrun       (Debian/Ubuntu: /usr/lib/podman/quadlet)
# Quadlet units are not "enabled" with systemctl; [Install] below handles autostart.

[Unit]
Description=Kidney Health food log (renal diet + type 1 diabetes nutrient tracker)
Documentation=https://github.com/ksullivan86/kidney-health/blob/main/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Container]
# Preferred for a host managed from git: pin the release's multi-arch index digest (it is in the
# GitHub release notes; scripts/verify-image.sh checks it), remove AutoUpdate= below, and let
# Renovate or Dependabot bump tag and digest together:
#   Image=ghcr.io/ksullivan86/kidney-health:0.21.0@sha256:<index digest>
# Otherwise track the minor release: patch releases arrive through AutoUpdate, breaking changes
# never do. Do not track :latest (or :edge, the main branch) on a machine you care about.
Image=ghcr.io/ksullivan86/kidney-health:0.21
ContainerName=kidney-health
# `systemctl --user enable --now podman-auto-update.timer` pulls a newer image for this tag daily
# and restarts the unit, rolling back if it fails. Never mount podman.sock into a container for
# this (Watchtower-style updaters): that hands the container your whole account.
AutoUpdate=registry

# Network: pasta (the rootless default since Podman 5; on 4.9 install the `passt` package).
# slirp4netns would show every client, LAN included, as 10.0.2.100 (docs/security.md).
Network=pasta
# Loopback only: your reverse proxy on this host is the only client. 0.0.0.0 would let any LAN
# device bypass the proxy and its login.
PublishPort=127.0.0.1:8000:8000

# /data on a named volume (kidney-health.volume); no exec, setuid or device files there.
# Bind mount instead: Volume=%h/kidney-data:/data:Z,U,noexec,nosuid,nodev
#   (:U chowns it to 10001 on every start, :Z relabels it for SELinux; never on $HOME itself)
Volume=kidney-health.volume:/data:noexec,nosuid,nodev

# User namespace: the default rootless mapping. Container UID 10001 is an unprivileged subordinate
# UID on the host, never your own. Do NOT add UserNS=keep-id (development only): it would run the
# app as YOUR host UID, so an escape could read ~/.ssh. Advanced isolation: UserNS=auto (docs).
User=10001
Group=10001
ReadOnly=true
# ReadOnly=true already adds tmpfs on /tmp, /var/tmp, /run and /dev/shm (ReadOnlyTmpfs=true, the
# default); this one sets safe options and a size for /tmp, where SQLite puts its temp files.
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
DropCapability=all
NoNewPrivileges=true
# SELinux (Fedora, RHEL, Alma): the container runs as container_t. Never SecurityLabelDisable=true.
PidsLimit=128
# Memory= needs Podman 5.5; this form works from 4.9 to 6.x. Rootless memory and pids limits need
# cgroup v2 (delegated by default). Add --cpus=1 only after delegating the cpu controller:
# /etc/systemd/system/user@.service.d/delegate.conf with Delegate=cpu cpuset io memory pids.
PodmanArgs=--memory=512m

# Secrets are files under /run/secrets, owned by the app user, mode 0400 (never env vars).
Secret=kidney-secret-key,type=mount,target=secret_key,uid=10001,gid=10001,mode=0400
Environment=SECRET_KEY_FILE=/run/secrets/secret_key
# Optional USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup):
#   printf '%s' "$USDA_KEY" | podman secret create kidney-usda-key -
# then uncomment both lines:
# Secret=kidney-usda-key,type=mount,target=usda_api_key,uid=10001,gid=10001,mode=0400
# Environment=USDA_API_KEY_FILE=/run/secrets/usda_api_key

# Proxy trust (docs/security.md has the per-topology table). With pasta, a proxy on this host shows
# up as the container's OWN address, not 127.0.0.1, so the default below matches nothing: proxy
# headers are ignored, which is safe. Put the address the app logs here; in AUTH_MODE=proxy also
# mount TRUSTED_PROXY_SECRET_FILE (a Secret= like the one above).
Environment=TRUSTED_PROXIES=127.0.0.1,::1
# The URL people type (scheme included). Its host passes the Host check (DNS-rebinding defence).
# Environment=PUBLIC_URL=https://food.home.example.net
# Environment=ALLOWED_HOSTS=food.home.example.net
# Environment=AUTH_MODE=local

# v0.3 features (deploy/.env.example explains each one). Meal guidance runs on the server and is on;
# everything that contacts the internet is OFF until switched on, and outbound HTTPS starts only for what
# you switch on (docs/network-allowlist.md): api.nal.usda.gov (a USDA key), world.openfoodfacts.org (Open
# Food Facts on AND the scanning person agreed), your AI provider, api.pwnedpasswords.com
# (PASSWORD_BREACH_CHECK). A line here LOCKS that setting in Settings → Admin;
# without it an admin switches it in the app.
# Environment=OFF_ENABLED=true
# Environment=OFF_CONTACT=admin@example.net
# Environment=GUIDANCE_ENABLED=true
# Environment=PLAN_DAYS_MAX=60
# Optional AI features (docs/ai.md has a recipe per provider). A cloud provider, its key as a secret:
#   printf '%s' "$AI_KEY" | podman secret create kidney-ai-key -
# Environment=AI_ENABLED=true
# Environment=AI_PROVIDER=openai
# Secret=kidney-ai-key,type=mount,target=ai_api_key,uid=10001,gid=10001,mode=0400
# Environment=AI_API_KEY_FILE=/run/secrets/ai_api_key
# Or a server on your LAN, bound to a LAN address (a host service on 127.0.0.1 stays unreachable, which is
# good; never pasta:--map-gw, see docs/deployment.md), listed in AI_PRIVATE_HOSTS:
# Environment=AI_PROVIDER=hermes
# Environment=AI_BASE_URL=http://192.168.1.10:8643/v1
# Environment=AI_MODEL=kidney
# Environment=AI_PRIVATE_HOSTS=192.168.1.10:8643
# A local AI and a cloud AI, both from the environment: a LiteLLM proxy on your LAN with two keys, one that can only call
# models on your own GPU (AI_PROVIDER, the local AI) and one that can only call cloud models (AI_CLOUD_PROVIDER, always the
# cloud AI). Each key is its own secret; the cloud AI names the company the proxy forwards to; both hosts are listed:
#   printf '%s' "$LOCAL_KEY" | podman secret create kidney-ai-local-key -
#   printf '%s' "$CLOUD_KEY" | podman secret create kidney-ai-cloud-key -
# Environment=AI_PROVIDER=litellm
# Environment=AI_PROVIDER_ROLE=local
# Environment=AI_BASE_URL=http://litellm.lan:4000/v1
# Environment=AI_MODEL=gemma
# Environment=AI_VISION_MODEL=gemma
# Secret=kidney-ai-local-key,type=mount,target=ai_api_key,uid=10001,gid=10001,mode=0400
# Environment=AI_API_KEY_FILE=/run/secrets/ai_api_key
# Environment=AI_CLOUD_PROVIDER=litellm
# Environment=AI_CLOUD_BASE_URL=http://litellm.lan:4000/v1
# Environment=AI_CLOUD_MODEL=claude-sonnet
# Environment=AI_CLOUD_UPSTREAM=Anthropic
# Secret=kidney-ai-cloud-key,type=mount,target=ai_cloud_api_key,uid=10001,gid=10001,mode=0400
# Environment=AI_CLOUD_API_KEY_FILE=/run/secrets/ai_cloud_api_key
# Environment=AI_PRIVATE_HOSTS=litellm.lan:4000
# Environment=AI_ROUTE_PHOTOS=local
# Environment=AI_ROUTE_LABS=local
# Environment=AI_ROUTE_MEAL_IDEAS=cloud
# Environment=AI_ROUTE_DESCRIBE=cloud
# Environment=AI_ROUTE_CHAT=cloud
# Environment=AI_ROUTE_RECIPES=cloud
# Let the people you tick in Server administration → Users pick the local or the cloud AI per feature (docs/ai.md):
# Environment=AI_PERSON_ROUTE_CHOICE_ENABLED=true
# What the live evaluation said about the model in use (docs/ai.md "How well each AI is doing"): the reports scripts/ai_eval.py
# writes, in a folder mounted read-only:
# Volume=%h/ai-eval:/ai-eval:ro,Z
# Environment=AI_EVAL_REPORTS_DIR=/ai-eval
# Assistant access (docs/assistant.md): each person may make personal tokens (Settings → Outside AI apps) for a
# chat assistant they connect, such as Open WebUI. A token reads; if the person ticks "Can also save food and
# recipes" it can also log food and save recipes. Off by default; the app contacts nothing for it.
# Environment=ASSISTANT_ENABLED=true
# Phone shortcuts (docs/push.md): each person may make device tokens (Settings → Phone shortcuts) that an iPhone Shortcut uses to
# add weights and blood pressure readings to their own log (POST /push/v1/body). A token can only add. Off by default.
# Environment=PUSH_ENABLED=true
# Read-only sharing (docs/accounts.md): a person may let someone else with an account here read parts of their log. Off by default.
# Environment=SHARING_ENABLED=true
# Test accounts for testers (docs/test-the-full-app.md): tester and tester-helper, never admins. Their one password is a Podman
# secret (printf '%s' 'a long password' | podman secret create kidney-test-password -). Off by default.
# Environment=TEST_ACCOUNT_ENABLED=true
# Secret=kidney-test-password,type=mount,target=test_account_password,uid=10001,gid=10001,mode=0400
# Environment=TEST_ACCOUNT_PASSWORD_FILE=/run/secrets/test_account_password
# Environment=TEST_ACCOUNT_AI=false
# Connected devices (docs/devices.md): each person may connect their own Withings scale or blood pressure monitor. Needs PUBLIC_URL.
# Withings sends people back to <PUBLIC_URL>/api/devices/withings/callback. The client secret of your free Withings developer app is
# a Podman secret (podman secret create kidney-withings-secret FILE). Off by default.
# Environment=DEVICES_ENABLED=true
# Environment=WITHINGS_ENABLED=true
# Environment=WITHINGS_CLIENT_ID=your-withings-client-id
# Secret=kidney-withings-secret,type=mount,target=withings_client_secret,uid=10001,gid=10001,mode=0400
# Environment=WITHINGS_CLIENT_SECRET_FILE=/run/secrets/withings_client_secret
# Whoop the same way: <PUBLIC_URL>/api/devices/whoop/callback; podman secret create kidney-whoop-secret FILE. Off by default.
# Environment=WHOOP_ENABLED=true
# Environment=WHOOP_CLIENT_ID=your-whoop-client-id
# Secret=kidney-whoop-secret,type=mount,target=whoop_client_secret,uid=10001,gid=10001,mode=0400
# Environment=WHOOP_CLIENT_SECRET_FILE=/run/secrets/whoop_client_secret
# Your own list app (docs/list-sync.md): each person may send the shopping list to their own Grocy, KitchenOwl or Mealie. A list
# app on a home address must be listed (host names, addresses or networks). Recipe pages (docs/recipe-import.md). Off by default.
# Environment=LIST_SYNC_ENABLED=true
# Environment=LIST_SYNC_ALLOWED_HOSTS=grocy.lan,192.168.1.0/24
# Environment=RECIPE_IMPORT_ENABLED=true
# Names listed here are first values, not locks: written once, then changeable in the app (docs/deployment.md).
# Environment=SETTINGS_INITIAL_ONLY=SHARING_ENABLED,PUSH_ENABLED
# Admins must use two-step sign-in before they can open Server administration (docs/accounts.md). Off by default.
# Environment=AUTH_REQUIRE_TWO_STEP_ADMINS=true
# Environment=PASSWORD_BREACH_CHECK=true
# Sign in with Authentik, Google or another OpenID Connect provider (docs/accounts.md). Needs PUBLIC_URL. The provider's return
# address is <PUBLIC_URL>/api/auth/oidc/callback. The client secret is a Podman secret (podman secret create kidney-oidc-secret FILE).
# Environment=OIDC_ENABLED=true
# Environment=OIDC_ISSUER=https://auth.example.org/application/o/kidney-health/
# Environment=OIDC_CLIENT_ID=your-client-id
# Secret=kidney-oidc-secret,type=mount,target=oidc_client_secret,uid=10001,gid=10001,mode=0400
# Environment=OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# Environment=OIDC_BUTTON_LABEL=Sign in with Authentik
# Environment=OIDC_ALLOW_PRIVATE_ISSUER=true
# Or Authentik and Google together, each with its own button, secret and return address <PUBLIC_URL>/api/auth/oidc/callback/<name>:
# Environment=OIDC_ENABLED=true
# Environment=OIDC_PROVIDERS=authentik,google
# Environment=OIDC_AUTHENTIK_ISSUER=https://auth.example.org/application/o/kidney-health/
# Environment=OIDC_AUTHENTIK_CLIENT_ID=your-authentik-client-id
# Secret=kidney-oidc-authentik,type=mount,target=oidc_authentik_secret,uid=10001,gid=10001,mode=0400
# Environment=OIDC_AUTHENTIK_CLIENT_SECRET_FILE=/run/secrets/oidc_authentik_secret
# Environment=OIDC_AUTHENTIK_ALLOW_PRIVATE_ISSUER=true
# Environment=OIDC_GOOGLE_ISSUER=https://accounts.google.com
# Environment=OIDC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Secret=kidney-oidc-google,type=mount,target=oidc_google_secret,uid=10001,gid=10001,mode=0400
# Environment=OIDC_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/oidc_google_secret
# Environment=OIDC_GOOGLE_ALLOWED_DOMAINS=example.org
# Only the provider buttons and passkeys, no passwords (first link your own admin account; docs/accounts.md):
# Environment=OIDC_ONLY=true
# Tokens for outside AI apps and phone shortcuts always expire (by default people may choose "Never"):
# Environment=TOKENS_ALLOW_NEVER_EXPIRING=false

# Health: exec form (JSON array). A plain string would run through /bin/sh, which the image does
# not have, and the check would always fail.
HealthCmd=["python", "-m", "app.healthcheck"]
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=15s
HealthRetries=3
# Kill the container when the check keeps failing, so systemd restarts it.
HealthOnFailure=kill
# Podman >= 5.0: report the unit started only once the app is healthy.
# Notify=healthy

[Service]
Restart=always
RestartSec=5
# Give the first image pull time on slow links.
TimeoutStartSec=900

[Install]
WantedBy=default.target
