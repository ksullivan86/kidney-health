# kidney-health.container -- systemd Quadlet unit for ROOTLESS Podman (the recommended way to run
# the app on a single host). Spec: docs/dev/research/01-rootless-and-security.md §5.2 and §10.
# Works with Podman >= 4.9 (Ubuntu 24.04 LTS); the optional Notify=healthy needs 5.0, Memory= 5.5.
# Full guide: docs/deployment.md. Hardening background: docs/security.md.
#
# Install as the unprivileged user that will run the container (never root):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/quadlet/kidney-health.container deploy/quadlet/kidney-health.volume ~/.config/containers/systemd/
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))" | podman secret create kidney-secret-key -
#   systemctl --user daemon-reload                  # Quadlet generates kidney-health.service
#   systemctl --user start kidney-health.service
#   sudo loginctl enable-linger "$USER"             # keep it running after logout; start at boot
#   journalctl --user -u kidney-health | grep 'FIRST-RUN SETUP'     # the one-time setup code
#
# Check the result:
#   podman info --format '{{.Host.Security.Rootless}}'        # true
#   podman top kidney-health user huser                       # 10001  <a subordinate UID>, never your UID
#   podman inspect kidney-health --format '{{.HostConfig.ReadonlyRootfs}} {{.HostConfig.CapDrop}}'
# Typos make daemon-reload skip the unit silently; check with the generator:
#   /usr/libexec/podman/quadlet -user -dryrun       (Debian/Ubuntu: /usr/lib/podman/quadlet)
# Quadlet units are not "enabled" with systemctl; [Install] below handles autostart.

[Unit]
Description=Kidney Health food log (renal diet + type 1 diabetes nutrient tracker)
Documentation=https://github.com/ksullivan86/kidney-health/blob/main/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Container]
# Track the minor release: patch releases arrive through AutoUpdate, breaking changes never do.
# Do not track :latest (or :edge, the main branch) on a machine you care about. To pin a verified
# digest instead: Image=ghcr.io/ksullivan86/kidney-health:0.3.0@sha256:... (scripts/verify-image.sh)
Image=ghcr.io/ksullivan86/kidney-health:0.3
ContainerName=kidney-health
# `systemctl --user enable --now podman-auto-update.timer` pulls a newer image for this tag daily
# and restarts the unit, rolling back if it fails. Never mount podman.sock into a container for
# this (Watchtower-style updaters): that hands the container your whole account.
AutoUpdate=registry

# Network: pasta (the rootless default since Podman 5; on 4.9 install the `passt` package).
# slirp4netns would show every client, LAN included, as 10.0.2.100 (docs/security.md).
Network=pasta
# Loopback only: your reverse proxy on this host is the only client. 0.0.0.0 would let any LAN
# device bypass the proxy and its login.
PublishPort=127.0.0.1:8000:8000

# /data on a named volume (kidney-health.volume); no exec, setuid or device files there.
# Bind mount instead: Volume=%h/kidney-data:/data:Z,U,noexec,nosuid,nodev
#   (:U chowns it to 10001 on every start, :Z relabels it for SELinux; never on $HOME itself)
Volume=kidney-health.volume:/data:noexec,nosuid,nodev

# User namespace: the default rootless mapping. Container UID 10001 is an unprivileged subordinate
# UID on the host, never your own. Do NOT add UserNS=keep-id (development only): it would run the
# app as YOUR host UID, so an escape could read ~/.ssh. Advanced isolation: UserNS=auto (docs).
User=10001
Group=10001
ReadOnly=true
# ReadOnly=true already adds tmpfs on /tmp, /var/tmp, /run and /dev/shm (ReadOnlyTmpfs=true, the
# default); this one sets safe options and a size for /tmp, where SQLite puts its temp files.
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
DropCapability=all
NoNewPrivileges=true
# SELinux (Fedora, RHEL, Alma): the container runs as container_t. Never SecurityLabelDisable=true.
PidsLimit=128
# Memory= needs Podman 5.5; this form works from 4.9 to 6.x. Rootless memory and pids limits need
# cgroup v2 (delegated by default). Add --cpus=1 only after delegating the cpu controller:
# /etc/systemd/system/user@.service.d/delegate.conf with Delegate=cpu cpuset io memory pids.
PodmanArgs=--memory=512m

# Secrets are files under /run/secrets, owned by the app user, mode 0400 (never env vars).
Secret=kidney-secret-key,type=mount,target=secret_key,uid=10001,gid=10001,mode=0400
Environment=SECRET_KEY_FILE=/run/secrets/secret_key
# Optional USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup):
#   printf '%s' "$USDA_KEY" | podman secret create kidney-usda-key -
# then uncomment both lines:
# Secret=kidney-usda-key,type=mount,target=usda_api_key,uid=10001,gid=10001,mode=0400
# Environment=USDA_API_KEY_FILE=/run/secrets/usda_api_key

# Proxy trust (docs/security.md has the per-topology table). With pasta, a proxy on this host shows
# up as the container's OWN address, not 127.0.0.1, so the default below matches nothing: proxy
# headers are ignored, which is safe. Put the address the app logs here; in AUTH_MODE=proxy also
# mount TRUSTED_PROXY_SECRET_FILE (a Secret= like the one above).
Environment=TRUSTED_PROXIES=127.0.0.1,::1
# The URL people type (scheme included). Its host passes the Host check (DNS-rebinding defence).
# Environment=PUBLIC_URL=https://food.home.example.net
# Environment=ALLOWED_HOSTS=food.home.example.net
# Environment=AUTH_MODE=local

# v0.3 features (deploy/.env.example explains each one). Meal guidance runs on the server and is on;
# everything that contacts the internet is OFF until switched on, and outbound HTTPS starts only for what
# you switch on (docs/network-allowlist.md): api.nal.usda.gov (a USDA key), world.openfoodfacts.org (Open
# Food Facts on AND the scanning person agreed), your AI provider, api.pwnedpasswords.com
# (PASSWORD_BREACH_CHECK). A line here LOCKS that setting in Settings → Admin;
# without it an admin switches it in the app.
# Environment=OFF_ENABLED=true
# Environment=OFF_CONTACT=admin@example.net
# Environment=GUIDANCE_ENABLED=true
# Optional AI ideas (docs/ai.md has a recipe per provider). A cloud provider, its key as a secret:
#   printf '%s' "$AI_KEY" | podman secret create kidney-ai-key -
# Environment=AI_ENABLED=true
# Environment=AI_PROVIDER=openai
# Secret=kidney-ai-key,type=mount,target=ai_api_key,uid=10001,gid=10001,mode=0400
# Environment=AI_API_KEY_FILE=/run/secrets/ai_api_key
# Or a server on your LAN, bound to a LAN address (a host service on 127.0.0.1 stays unreachable, which is
# good; never pasta:--map-gw, see docs/deployment.md), listed in AI_PRIVATE_HOSTS:
# Environment=AI_PROVIDER=hermes
# Environment=AI_BASE_URL=http://192.168.1.10:8643/v1
# Environment=AI_MODEL=kidney
# Environment=AI_PRIVATE_HOSTS=192.168.1.10:8643
# Environment=PASSWORD_BREACH_CHECK=true

# Health: exec form (JSON array). A plain string would run through /bin/sh, which the image does
# not have, and the check would always fail.
HealthCmd=["python", "-m", "app.healthcheck"]
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=15s
HealthRetries=3
# Kill the container when the check keeps failing, so systemd restarts it.
HealthOnFailure=kill
# Podman >= 5.0: report the unit started only once the app is healthy.
# Notify=healthy

[Service]
Restart=always
RestartSec=5
# Give the first image pull time on slow links.
TimeoutStartSec=900

[Install]
WantedBy=default.target
