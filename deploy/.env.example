# Environment for deploy/compose.yaml (copy to deploy/.env) or for the Quadlet unit
# (copy to ~/.config/containers/systemd/kidney-health.env).
# Keep the real file out of git and `chmod 600` it.

# Optional. Enables the "Search USDA" button (live FoodData Central lookups and imports).
# Free key: https://fdc.nal.usda.gov/api-key-signup  (DEMO_KEY also works, 30 requests/hour)
USDA_API_KEY=

# Optional. When set, every page and API call requires HTTP Basic auth: any username,
# this password. Leave empty when the app sits behind Authelia or another
# reverse-proxy login on a trusted LAN. Empty means "no auth".
APP_PASSWORD=
