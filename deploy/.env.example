# Optional, NON-SECRET settings for deploy/compose.yaml. Copy to deploy/.env (git-ignored) and edit.
# Compose reads deploy/.env for the ${...} substitutions in compose.yaml; empty values mean "unset".
#
# Secrets do NOT go here. API keys, SECRET_KEY and passwords are files in deploy/secrets/ that the
# app reads through *_FILE variables (environment variables leak into `inspect` output, child
# processes and crash dumps). See the header of deploy/compose.yaml.
# The Quadlet unit (deploy/quadlet/) sets the same keys with Environment= lines instead.

# Host port on 127.0.0.1 (your reverse proxy connects to it).
HOST_PORT=8000

# The address people type, scheme included. Its host passes the Host check, and invite and reset
# links are built from it. Choose it before installing the app on phones: a different host, scheme
# or port is a different app with empty storage (docs/https.md).
PUBLIC_URL=

# More host names the app should answer to (comma list; *.example.org wildcards).
# localhost and IP literals always work; everything else gets 400 "Unknown host".
ALLOWED_HOSTS=

# Whose X-Forwarded-For / X-Forwarded-Proto to believe. Read the per-topology table in
# docs/security.md first: with rootless Podman (pasta) a proxy on the same host shows up as the
# container's own address, and with rootless Docker every client shows up as the RootlessKit gateway.
TRUSTED_PROXIES=127.0.0.1,::1

# local (accounts with passwords; default) | proxy (Authelia, Authentik, tailscale serve: also add
# TRUSTED_PROXY_USER_HEADER and TRUSTED_PROXY_SECRET_FILE to compose.yaml, see docs/deployment.md)
# | none (no sign-in at all: anyone who can open the page can read and change the data).
AUTH_MODE=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Server settings. Leave a value empty to let an admin choose it in Server administration → Server
# settings. A value here LOCKS that setting, unless its name is in SETTINGS_INITIAL_ONLY: then it is only
# the first value, written on the first start, and an admin can change it in the app afterwards
# (docs/deployment.md, "Set it up by code"). A comma list of names, or * for every setting below.
SETTINGS_INITIAL_ONLY=

# The name shown in the app, and who may make an account: invite (default), closed or open.
INSTANCE_NAME=
REGISTRATION_MODE=

# ---- v0.3 features. Every feature that contacts the internet is OFF until switched on, and the app makes
# no outbound request for a feature that is off (docs/network-allowlist.md lists the host each one
# contacts). Meal guidance runs on the server only and is on.

# Barcode lookups with Open Food Facts (world.openfoodfacts.org; only the barcode digits are sent, and
# only for people who agreed in Settings → Food data). The first-run screen also offers this switch.
OFF_ENABLED=
# Who to contact about your lookups (goes into the User-Agent, as Open Food Facts asks): an admin e-mail
# address is better than the default project URL. No round brackets or backslash.
OFF_CONTACT=

# Rule-based meal guidance (What fits now, swaps, Plan the rest of my day, insights; all on the server,
# nothing leaves it). On unless set to false.
GUIDANCE_ENABLED=
# Plan several days: the most days one plan may hold (1 to 90; empty = 60), and the most when the plan's
# ideas come from AI (empty = 31; each day costs AI calls). Lower PLAN_DAYS_MAX on a small server.
PLAN_DAYS_MAX=
PLAN_DAYS_AI_MAX=

# Optional AI ideas (docs/ai.md). AI_ENABLED is the server-wide switch; the provider is env-only:
# AI_PROVIDER is a preset (openai, openrouter, nous_portal, ollama, lmstudio, llamacpp, vllm, litellm,
# hermes, openai_compatible), AI_BASE_URL its address when the preset has none, AI_MODEL the model,
# AI_VISION_MODEL a model that reads photos (empty = photo features off). A local server on your LAN must
# be listed in AI_PRIVATE_HOSTS (host:port, comma list, no wildcards). A cloud key is a FILE secret:
# AI_API_KEY_FILE in compose.yaml. deploy/compose.ai-ollama.yaml sets all of this for a local Ollama.
AI_ENABLED=
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_VISION_MODEL=
AI_PRIVATE_HOSTS=

# Which AI each feature uses (docs/ai.md "Which AI does each feature use?"). The provider above is "local" (a host
# in AI_PRIVATE_HOSTS: Ollama on your own network) or "cloud" (a company's service): AI_PROVIDER_ROLE=local|cloud.
# Each feature is pinned to local, cloud or off, and until you pin a feature to cloud it is local, so with only a
# cloud provider the features stay off: that is the least-trusting default (what a photo, your meal data and your
# Ask messages send goes only where you chose). AI_ROUTE_PHOTOS, AI_ROUTE_MEAL_IDEAS, AI_ROUTE_DESCRIBE and
# AI_ROUTE_CHAT take local, cloud, off or any (any: the older rule, whichever shared provider a person chose).
# AI_ROUTE_RECIPES (AI recipes) takes the same values. AI_ROUTE_PHOTOS, AI_ROUTE_MEAL_IDEAS, AI_ROUTE_DESCRIBE and
# AI_ROUTE_RECIPES (not AI_ROUTE_CHAT) also take local_then_cloud: the local AI first, and the cloud AI only if the local
# answer fails the app's checks (docs/ai.md).
# AI_ROUTE_LABS (reading a photo of a lab report, which can show a name and a date of birth) takes only local or off:
# it never goes to a cloud AI and never to a person's own provider.
# Leave them empty to choose in Server administration instead; a value here locks the choice there.
AI_PROVIDER_ROLE=
AI_ROUTE_PHOTOS=
AI_ROUTE_MEAL_IDEAS=
AI_ROUTE_DESCRIBE=
AI_ROUTE_CHAT=
AI_ROUTE_LABS=
AI_ROUTE_RECIPES=
# Cooking steps written by AI in AI recipes: off until you have run scripts/ai_eval.py on your model (docs/ai.md).
AI_RECIPE_STEPS=

# A cloud AI as well as the local one, both from the environment (docs/ai.md, "A local AI and a cloud AI, both from the
# environment"). AI_CLOUD_PROVIDER is a preset and is always the cloud AI; give the provider above AI_PROVIDER_ROLE=local.
# AI_CLOUD_BASE_URL, AI_CLOUD_MODEL and AI_CLOUD_VISION_MODEL work like their AI_ twins; its key is a FILE secret,
# AI_CLOUD_API_KEY_FILE in compose.yaml. A cloud AI on your LAN (a LiteLLM proxy with a cloud-only key) must be listed in
# AI_PRIVATE_HOSTS too, but that does not make it local: lab report photos never go to it. When the preset is a server you
# run (litellm, vllm, openai_compatible, ...) AI_CLOUD_UPSTREAM must name the company it forwards to (for example Anthropic);
# the consent line then says "Goes through your admin's LiteLLM proxy to Anthropic ...". Tuning (AI_CLOUD_TIMEOUT_S,
# AI_CLOUD_MAX_TOKENS, AI_CLOUD_CONTEXT_TOKENS, AI_CLOUD_STRUCTURED_OUTPUT, AI_CLOUD_REASONING_EFFORT) is in docs/ai.md.
AI_CLOUD_PROVIDER=
AI_CLOUD_BASE_URL=
AI_CLOUD_MODEL=
AI_CLOUD_VISION_MODEL=
AI_CLOUD_UPSTREAM=
# What the live evaluation said about the model each feature uses (docs/ai.md "How well each AI is doing"). A folder INSIDE the
# container that holds the reports scripts/ai_eval.py writes, for example /ai-eval. Mount your reports folder read-only
# (compose.yaml has the commented volume line). Leave it empty and the admin screen says there is no reports folder.
AI_EVAL_REPORTS_DIR=

# Assistant access (docs/assistant.md): personal tokens a person makes in Settings for a chat assistant that
# reads their own food log and targets and, only if the person ticks "Can also save food and recipes" for that
# token, also saves food and recipes. Off unless set to true here or switched on in Server administration.
# Nothing leaves the server for it.
ASSISTANT_ENABLED=

# Admins must use two-step sign-in (docs/accounts.md#two-step-sign-in): true means an admin opens Server administration only
# after turning on two-step sign-in in Settings → Account. Off unless set to true here or switched on in Server administration.
AUTH_REQUIRE_TWO_STEP_ADMINS=

# Phone shortcuts (docs/push.md): each person may make device tokens in Settings for an iPhone Shortcut that adds weights and
# blood pressure readings to their own log (POST /push/v1/body). A token can only add; it reads nothing. Off unless set to
# true here or switched on in Server administration. The phone must reach the server (home network or VPN); if a reverse proxy
# lists the paths it passes on, add /push/v1/ next to /mcp. Nothing leaves the server for it.
PUSH_ENABLED=

# Read-only sharing (docs/accounts.md, "Sharing with a caregiver"): each person may send a link to someone with an account
# here, who can then read the parts they ticked (food log, labs, weight and blood pressure, symptoms) and change nothing.
# Off unless set to true here or switched on in Server administration. Nothing leaves the server for it.
SHARING_ENABLED=

# A published copy of the patient handbook (e.g. GitHub Pages), used for Learn links when this server
# serves none. The image serves its own copy at /learn, so this is normally empty.
HANDBOOK_PUBLIC_URL=

# ---- Sign in with another account (OpenID Connect: your own Authentik, Google, Authelia, Keycloak, Pocket ID ...).
# Off unless OIDC_ENABLED=true. Needs AUTH_MODE=local and PUBLIC_URL. Tell your provider this exact return address:
#   <PUBLIC_URL>/api/auth/oidc/callback
# The client secret is never set here: put it in deploy/secrets/oidc_client_secret and uncomment
# OIDC_CLIENT_SECRET_FILE and the secret in compose.yaml. Setup for Authentik and Google: docs/accounts.md.
OIDC_ENABLED=
# Exactly as the provider names it: https://accounts.google.com, or Authentik's
# https://auth.example.org/application/o/<slug>/ (with the slash at the end).
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Space-separated; must include openid. Empty: openid email profile.
OIDC_SCOPES=
# true lets the server reach a provider on a private address (a home Authentik on the LAN or a VPN).
OIDC_ALLOW_PRIVATE_ISSUER=
# Who may sign in. Empty: an admin chooses in Server administration → Server settings → Single sign-on.
# The words on the button, for example: Sign in with Authentik
OIDC_BUTTON_LABEL=
# true makes an account for someone new at their first sign-in. Keep it off with Google unless you also
# set OIDC_ALLOWED_DOMAINS: anyone in the world has a Google account.
OIDC_ALLOW_SIGNUP=
# true gives someone the account you made for them in People with their verified email as its username, if nobody has used it
# yet (never a self-registered account, never an admin account).
OIDC_LINK_BY_EMAIL=
# Comma list of email domains allowed in, for example example.org, family.net. Empty: any.
OIDC_ALLOWED_DOMAINS=
# Comma list of provider groups whose members are admins here, for example authentik Admins. Empty: roles are set here.
OIDC_ADMIN_GROUPS=

# Refuse new passwords found in the Have I Been Pwned list (api.pwnedpasswords.com; only 5 characters
# of a hash leave the server). Off unless set to true.
PASSWORD_BREACH_CHECK=
