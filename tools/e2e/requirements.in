# Playwright for the browser harnesses in tools/e2e (CI runs learn.py in the "handbook" job with the
# runner's Google Chrome, so no browser is downloaded). Same version as requirements-tools.txt;
# constrained by requirements-dev.lock (scripts/lock.sh passes it to pip-compile) so it installs next
# to the app's dependencies without changing them. Regenerate with scripts/lock.sh; install with
#   pip install --require-hashes --no-deps -r tools/e2e/requirements.lock
playwright==1.63.0
